# --- Database ---------------------------------------------------------------
# MongoDB 6.0+ **replica set** (transactions require one; Atlas clusters already are).
# Local: `docker compose up -d` gives mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=restaurant_os
# For a zero-install try-out you can use MONGODB_URI=memory (in-process, data is lost on restart). Not for real use.

# --- Security ---------------------------------------------------------------
# Authentication/encryption secret: 32+ random bytes, e.g. `openssl rand -base64 48`.
# Used to HMAC session/invite tokens and derive the key that encrypts stored payment secrets.
APP_SECRET=replace-with-a-long-random-string
# Public origin of the app (used for invite links and absolute URLs)
APP_URL=http://localhost:3000

# --- Platform administrator -----------------------------------------------
# Used only by `npm run platform:create-admin`; creating an existing email fails
# rather than resetting its password.
PLATFORM_ADMIN_NAME=Platform Administrator
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- SMTP ------------------------------------------------------------------
# Invitations are emailed automatically when these values are configured.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Cloudflare R2 ----------------------------------------------------------
# Public URL should be an HTTPS custom domain or R2 public-bucket URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Defaults ---------------------------------------------------------------
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_COUNTRY=KE

# --- Paystack (subscriptions) -------------------------------------------------
# Your platform's own Paystack keys; used only to charge restaurants for their plan.
# Leave blank to disable online subscription payments (operators can still record payments by hand).
# Webhook URL to set in the Paystack dashboard: {APP_URL}/api/webhooks/paystack
# Restaurants' own Paystack keys (for taking customer payments) are NOT configured here;
# each owner adds them under Settings -> Online payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Security ----------------------------------------------------------------
# Reverse proxies in front of the app (each appends to X-Forwarded-For). The client IP is the Nth entry from the RIGHT.
# 1 = one proxy/load balancer (typical). 0 = trust no forwarded header. Getting this wrong lets attackers fake their IP.
TRUSTED_PROXY_HOPS=1
# Optional: only these IPs/CIDRs may open the operator console (/platform); everyone else gets a plain 404.
# PLATFORM_ALLOWED_IPS=203.0.113.7,10.0.0.0/8
